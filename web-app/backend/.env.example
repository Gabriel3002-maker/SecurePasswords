# Database
DATABASE_URL=sqlite:///./passwords.db
# Para PostgreSQL: postgresql://user:password@localhost/passwords_db

# Security (IMPORTANT: Genera tus propias claves con: python -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(32)); print('ENCRYPTION_KEY=' + secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# CORS - dominios permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:9000,http://localhost:8000

# App
APP_NAME=Gestor de Contraseñas
DEBUG=True
